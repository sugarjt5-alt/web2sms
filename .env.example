# Энэ файлыг .env нэрээр хуулж, утгуудыг бөглөнө: cp .env.example .env
# Docker Compose .env файлаас автоматаар уншина.

# Дор хаяж 32 тэмдэгт, санамсаргүй. Үүсгэх: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend-ийн хаяг (production дээр жинхэнэ домэйн: https://sms.example.mn)
CORS_ORIGIN=http://localhost:3000

# Шинээр бүртгүүлсэн байгууллагад өгөх үнэгүй туршилтын кредит
SIGNUP_FREE_CREDITS=0
